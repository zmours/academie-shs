---
// « Cours en ligne » : quatre atouts et une classe en direct dessinée en HTML et CSS (aucune
// capture d'écran), qui s'anime quand elle arrive à l'écran (`src/scripts/interactions.ts`).
// Ne montrer QUE ce que l'outil fait réellement : pas de reprise d'une rediffusion à la seconde
// près, pas de rappel avant le cours. Ne pas nommer l'outil.
import { TEXTES } from '../i18n/textes';

const t = TEXTES.enligne;
const c = t.classe;
const ICONES = [
  '<rect x="2.5" y="5" width="14" height="14" rx="2"></rect><path d="M16.5 10l5-3v10l-5-3"></path>',
  '<rect x="3" y="4.5" width="18" height="16" rx="2"></rect><path d="M3 9.5h18M8 2.5v4M16 2.5v4"></path>',
  '<path d="M3 12a9 9 0 1 0 3-6.7L3 8"></path><path d="M3 3v5h5"></path><path d="M10 9l5 3-5 3z"></path>',
  '<path d="M14 2.5H6.5a2 2 0 0 0-2 2v15a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2V8z"></path><path d="M14 2.5V8h5.5M8.5 13h7M8.5 17h5"></path>',
];
---

<section class="enligne bande" id="enligne">
  <div class="cadre">
    <div data-revele>
      <p class="surtitre">{t.surtitre}</p>
      <h2>{t.titre}</h2>
      <p class="intro">{t.intro}</p>
      <div class="atouts">
        {
          t.atouts.map((a, i) => (
            <div class="atout">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONES[i]} />
              <h3>{a.titre}</h3>
              <p>{a.texte}</p>
            </div>
          ))
        }
      </div>
      <p class="appareils">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="6" y="2.5" width="12" height="19" rx="2.5"></rect><path d="M11 18h2"></path></svg>
        {t.appareils}
      </p>
    </div>

    <div class="classe" data-classe role="img" aria-label={t.illustration}>
      <div class="fenetre" aria-hidden="true">
        <div class="fenetre__barre">
          <span class="badge-direct"><i></i>{c.direct}</span>
          <b>{c.titre}</b>
          <span class="chrono" data-chrono>{c.chrono}</span>
        </div>
        <div class="fenetre__corps">
          <div class="tableau">
            <span class="ar" lang="ar">{c.tableauArabe}</span>
            <b>{c.tableau}</b>
            <ol>{c.lignes.map((l, i) => <li class={i === c.ligneSurlignee ? 'surlignee' : undefined}><span>{l}</span></li>)}</ol>
            <div class="sondage">
              <p><small>{c.sondage}</small>{c.question}</p>
              {
                c.reponses.map((rep) => (
                  <div class="choix">
                    <span>{rep.libelle}</span>
                    <span class="jauge"><i style={`width:${rep.pourcentage}%`}></i></span>
                    <span>{rep.pourcentage} %</span>
                  </div>
                ))
              }
            </div>
          </div>
          <div class="vignettes">
            <div class="vignette vignette--prof"><span class="avatar">{c.prof.replace(/^L’/, '').charAt(0).toUpperCase()}</span><span class="nom">{c.prof}</span><span class="onde"><i></i><i></i><i></i><i></i></span></div>
            {
              c.participants.map((p) => (
                <div class="vignette">
                  <span class="avatar" style={`background:${p.couleur}`}>{p.initiale}</span>
                  <span class="nom">{p.prenom}</span>
                  {p.main && <span class="main">✋</span>}
                </div>
              ))
            }
          </div>
        </div>
        <div class="outils">
          <span><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="9" y="3" width="6" height="12" rx="3"></rect><path d="M5 11a7 7 0 0 0 14 0M12 18v3"></path></svg></span>
          <span><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="6" width="13" height="12" rx="2"></rect><path d="M15.5 10.5l6-3.5v10l-6-3.5"></path></svg></span>
          <span class="actif">✋</span>
          <span><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20.5l1.4-5A8 8 0 1 1 21 12z"></path></svg></span>
          <span class="quitter"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15c4-4 12-4 16 0l-2 2-3-1v-2.5c-2-.7-4-.7-6 0V16l-3 1z"></path></svg></span>
        </div>
      </div>

      <div class="telephone" aria-hidden="true">
        <div class="telephone__ecran">
          <p class="telephone__heure">{t.heure}</p>
          {
            t.notifications.map(([titre, texte]) => (
              <div class="notif"><svg width="22" height="22"><use href="#medaillon"></use></svg><span><b>{titre}</b><span>{texte}</span></span></div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
