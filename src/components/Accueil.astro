---
// La page d'accueil, identique dans les trois langues : seuls les textes changent.
import { COURS, POLES, type CodePole, type Langue } from '../data/cours';
import { languesCours, TEXTES } from '../i18n/textes';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const t = TEXTES[langue];
const f = t.formulaire;
const codesPoles: CodePole[] = ['A', 'B', 'C'];
const cleTurnstile = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<section class="hero">
  <svg class="hero__etoile hero__etoile--1" viewBox="0 0 100 100" fill="none" aria-hidden="true">
    <rect x="23" y="23" width="54" height="54" stroke="#FFFFFF" stroke-width="1.5"></rect>
    <rect x="23" y="23" width="54" height="54" stroke="#FFFFFF" stroke-width="1.5" transform="rotate(45 50 50)"></rect>
    <circle cx="50" cy="50" r="14" stroke="#FFFFFF" stroke-width="1.5"></circle>
  </svg>
  <svg class="hero__etoile hero__etoile--2" viewBox="0 0 100 100" fill="none" aria-hidden="true">
    <rect x="23" y="23" width="54" height="54" stroke="#FFFFFF" stroke-width="1.5"></rect>
    <rect x="23" y="23" width="54" height="54" stroke="#FFFFFF" stroke-width="1.5" transform="rotate(45 50 50)"></rect>
    <circle cx="50" cy="50" r="14" stroke="#FFFFFF" stroke-width="1.5"></circle>
  </svg>
  <div class="hero__filigrane" aria-hidden="true">علم</div>
  <div class="conteneur hero__contenu">
    <p class="hero__verset" lang="ar" dir="rtl">وَقُل رَّبِّ زِدْنِي عِلْمًا</p>
    <h1>{t.hero.titreDebut}<span>{t.hero.titreAccent}</span>.</h1>
    <p class="hero__sous-titre">{t.hero.sousTitre}</p>
    <ul class="hero__pastilles" role="list" style="margin: 0; padding: 0; list-style: none">
      {t.hero.pastilles.map((p) => <li class="hero__pastille">{p}</li>)}
    </ul>
    <div class="hero__actions">
      <a href="#preinscription" class="bouton bouton--or bouton--grand">{t.hero.ctaPrincipal}</a>
      <a href="#cours" class="bouton bouton--verre bouton--grand">{t.hero.ctaSecondaire}</a>
    </div>
    <div class="hero__chiffres">
      {
        t.hero.chiffres.map((c) => (
          <div class="hero__chiffre">
            <strong>{c.valeur}</strong>
            <span>{c.libelle}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section class="atouts" aria-label={t.atouts.join(', ')}>
  <ul class="conteneur atouts__liste">
    <li>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#1E4D99" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18"></path><path d="M5 21V10l7-5 7 5v11"></path><path d="M10 21v-5h4v5"></path></svg>
      {t.atouts[0]}
    </li>
    <li>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#1E4D99" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="14" height="14" rx="2"></rect><path d="M16 10l6-3v10l-6-3"></path></svg>
      {t.atouts[1]}
    </li>
    <li>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#1E4D99" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 5h7a3 3 0 0 1 3 3v12a2 2 0 0 0-2-2H2z"></path><path d="M22 5h-7a3 3 0 0 0-3 3v12a2 2 0 0 1 2-2h8z"></path></svg>
      {t.atouts[2]}
    </li>
    <li>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#1E4D99" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"></path></svg>
      {t.atouts[3]}
    </li>
  </ul>
</section>

<section id="cours" class="section section--pale">
  <div class="conteneur">
    <div class="entete-section">
      <span class="pastille">{t.catalogue.pastille}</span>
      <h2>{t.catalogue.titre}</h2>
      <p>{t.catalogue.intro}</p>
    </div>

    <div class="filtres" role="group" aria-label={t.catalogue.filtres}>
      <button type="button" class="filtre" data-filtre="tous" aria-pressed="true">
        <span class="filtre__point" style="background: #F5B42A"></span>{t.catalogue.tous}
        <span class="filtre__nombre">{COURS.length}</span>
      </button>
      {
        codesPoles.map((code) => (
          <button type="button" class="filtre" data-filtre={code} aria-pressed="false">
            <span class="filtre__point" style={`background: ${POLES[code].couleur}`} />
            {POLES[code].nom[langue]}
            <span class="filtre__nombre">{COURS.filter((c) => c.pole === code).length}</span>
          </button>
        ))
      }
    </div>

    <div class="grille-cours">
      {
        COURS.map((c) => (
          <article class="carte" data-cours={c.id} data-pole={c.pole}>
            <div class="carte__bandeau" style={`background: ${POLES[c.pole].degrade}`}>
              <span class="carte__pole">{POLES[c.pole].nom[langue]}</span>
              <span class="carte__niveau">{c.niveau[langue]}</span>
              <span class="carte__mot" lang="ar" aria-hidden="true">
                {c.mot}
              </span>
            </div>
            <div class="carte__corps">
              <h3 class="carte__titre">{c.titre[langue]}</h3>
              {langue !== 'ar' && (
                <p class="carte__titre-arabe" lang="ar" dir="rtl" style="text-align: start">
                  {c.titre.ar}
                </p>
              )}
              <p class="carte__description">{c.description[langue]}</p>
              <p class="carte__reference">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#5B6478" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M2 5h7a3 3 0 0 1 3 3v12a2 2 0 0 0-2-2H2z" />
                  <path d="M22 5h-7a3 3 0 0 0-3 3v12a2 2 0 0 1 2-2h8z" />
                </svg>
                <span>{c.reference[langue]}</span>
              </p>
              <div class="carte__espace" />
              <button type="button" class="bouton carte__ajouter" data-ajouter={c.id} aria-pressed="false">
                <span class="si-libre">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                    <path d="M12 5v14M5 12h14" />
                  </svg>
                  {t.catalogue.ajouter}
                </span>
                <span class="si-choisi">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 6L9 17l-5-5" />
                  </svg>
                  {t.catalogue.ajoute}
                </span>
              </button>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section id="etapes" class="section">
  <div class="conteneur">
    <div class="entete-section">
      <span class="pastille pastille--or">{t.etapes.pastille}</span>
      <h2>{t.etapes.titre}</h2>
    </div>
    <ol class="etapes">
      {
        t.etapes.liste.map((e, i) => (
          <li class="etape">
            <span class="etape__numero" aria-hidden="true">{i + 1}</span>
            <h3>{e.titre}</h3>
            <p>{e.texte}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<section id="preinscription" class="section zone-formulaire">
  <div class="zone-formulaire__filigrane" aria-hidden="true">اقرأ</div>
  <div class="conteneur">
    <div class="carte-formulaire">
      <div data-bloc-formulaire>
        <h2>{f.titre}</h2>
        <p class="carte-formulaire__intro">{f.intro}</p>
      </div>

      <form
        class="formulaire"
        data-formulaire
        data-langue={langue}
        data-erreur-cours={f.erreurCours}
        data-erreur-langues={f.erreurLangues}
        data-libelle-envoi={f.envoi}
        novalidate
      >
        <input type="hidden" name="langue_site" value={langue} />
        <div class="piege" aria-hidden="true">
          <label>Site web <input type="text" name="site_web" tabindex="-1" autocomplete="off" /></label>
        </div>

        <div class="grille-2">
          <label class="champ">{f.prenom} *<input type="text" name="prenom" autocomplete="given-name" required maxlength="80" /></label>
          <label class="champ">{f.nom} *<input type="text" name="nom" autocomplete="family-name" required maxlength="80" /></label>
          <label class="champ">{f.courriel} *<input type="email" name="courriel" autocomplete="email" required maxlength="160" /></label>
          <label class="champ">{f.whatsapp} *<input type="tel" name="whatsapp" autocomplete="tel" required maxlength="25" placeholder="+33 6 12 34 56 78" /></label>
          <label class="champ">{f.pays}
            <select name="pays" autocomplete="country">
              {f.paysOptions.map((o) => <option value={o.valeur}>{o.libelle}</option>)}
            </select>
          </label>
          <label class="champ">{f.niveau}
            <select name="niveau">
              {f.niveauOptions.map((o) => <option value={o.valeur}>{o.libelle}</option>)}
            </select>
          </label>
        </div>

        <fieldset class="groupe" data-groupe="modules">
          <legend>{f.mesCours} * <span class="groupe__compte" data-compte></span></legend>
          {
            codesPoles.map((code) => (
              <div>
                <div class="groupe__pole">
                  <span class="filtre__point" style={`background: ${POLES[code].couleur}`} />
                  {POLES[code].nom[langue]}
                </div>
                <div class="puces">
                  {COURS.filter((c) => c.pole === code).map((c) => (
                    <label class="puce">
                      <input type="checkbox" name="modules" value={c.id} data-court={c.court[langue]} />
                      {c.court[langue]}
                    </label>
                  ))}
                </div>
              </div>
            ))
          }
          <p class="erreur-champ" data-erreur-pour="modules" hidden></p>
        </fieldset>

        <div class="grille-2">
          <fieldset class="groupe" data-groupe="langues">
            <legend>{f.langues} *</legend>
            <div class="puces">
              {
                languesCours(langue).map((o) => (
                  <label class="puce">
                    <input type="checkbox" name="langues" value={o.valeur} />
                    <span lang={o.valeur}>{o.libelle}</span>
                  </label>
                ))
              }
            </div>
            <p class="erreur-champ" data-erreur-pour="langues" hidden></p>
          </fieldset>
          <fieldset class="groupe">
            <legend>{f.creneaux}</legend>
            <div class="puces">
              {
                f.creneauxOptions.map((o) => (
                  <label class="puce">
                    <input type="checkbox" name="creneaux" value={o.valeur} />
                    {o.libelle}
                  </label>
                ))
              }
            </div>
          </fieldset>
        </div>

        <label class="champ">{f.origine}
          <select name="origine">
            {f.origineOptions.map((o) => <option value={o.valeur}>{o.libelle}</option>)}
          </select>
        </label>

        <div class="accords">
          <label class="accord"><input type="checkbox" name="majeur" required />{f.majeur} *</label>
          <label class="accord"><input type="checkbox" name="consentement" required />{f.consentement} *</label>
          <label class="accord accord--facultatif"><input type="checkbox" name="newsletter" />{f.newsletter}</label>
        </div>

        {cleTurnstile && <div class="cf-turnstile" data-sitekey={cleTurnstile} data-language={langue} />}

        <p class="message-erreur" data-message-erreur role="alert" hidden>{f.erreurEnvoi}</p>

        <button type="submit" class="bouton bouton--or formulaire__envoyer" data-envoyer>{f.envoyer}</button>

        <p class="formulaire__mentions">
          {f.mentions} <a href="/confidentialite/">{f.confidentialite}</a>
        </p>
      </form>

      <div class="merci" data-merci hidden tabindex="-1">
        <div class="merci__icone">
          <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="#047857" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"></path></svg>
        </div>
        <h2>{f.merciTitre}</h2>
        <p>{f.merciTexte}</p>
      </div>
    </div>
  </div>
</section>

<section id="faq" class="section">
  <div class="conteneur">
    <div class="entete-section">
      <span class="pastille">{t.faq.pastille}</span>
      <h2>{t.faq.titre}</h2>
    </div>
    <div class="faq">
      {
        t.faq.liste.map((q) => (
          <details>
            <summary>
              {q.q}
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1E4D99" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                <path d="M12 5v14M5 12h14" />
              </svg>
            </summary>
            <p>{q.r}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<div class="barre" data-barre aria-live="polite">
  <div class="barre__boite">
    <div class="barre__texte">
      <span class="barre__compte" data-barre-compte></span>
      <span class="barre__liste" data-barre-liste></span>
    </div>
    <a href="#preinscription" class="bouton bouton--or">{t.barre.finaliser}</a>
  </div>
</div>

{cleTurnstile && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script>
  import { demarrer } from '../scripts/preinscription';
  demarrer();
</script>
