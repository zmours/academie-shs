---
// La page d'accueil. Publiée en français seulement ; les textes viennent de `src/i18n/textes.ts`.
import { ANNEES, COMPETENCES, FIN_ETUDES, type Langue } from '../data/cours';
import { TEXTES } from '../i18n/textes';
import Experience from './Experience.astro';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const t = TEXTES[langue];
const f = t.formulaire;
const cleTurnstile = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const fleche = langue === 'ar' ? 'M19 12H5M11 6l-6 6 6 6' : 'M5 12h14M13 6l6 6-6 6';
---

<section class="cadre hero">
  <div class="hero__texte">
    <span class="pastille"><i></i>{t.hero.pastille}</span>
    <h1>{t.hero.titreDebut}<em>{t.hero.titreAccent}</em>{t.hero.titreFin}</h1>
    <p class="hero__chapo">{t.hero.chapo}</p>
    <ul class="hero__preuves">
      {t.hero.preuves.map((p) => <li>{p}</li>)}
    </ul>
    <div class="hero__actions">
      <a class="btn btn--safran btn--grand" href="#preinscription">
        {t.hero.cta}
        <span class="btn__fleche" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d={fleche}></path></svg></span>
      </a>
      <a class="lien" href="#programme">{t.hero.ctaSecondaire}</a>
    </div>
  </div>

  <div class="mosaique">
    <figure class="tuile tuile--photo">
      <img src="/photos/calligraphie.webp" alt={t.hero.photoAlt} width="1024" height="768" fetchpriority="high" />
      <figcaption>{t.hero.photoTexte}</figcaption>
      <span class="provisoire">{t.provisoire}</span>
    </figure>
    <div class="tuile tuile--safran">
      <span class="direct"><i></i>{t.hero.direct}</span>
      <p>{t.hero.directTexte}</p>
    </div>
    <div class="tuile tuile--sauge">
      <span class="compteur">3</span>
      <p>{t.hero.annees}</p>
    </div>
  </div>
</section>

<Experience langue={langue} />

<section class="programme apparait" id="programme">
  <div class="cadre">
    <div class="programme__tete">
      <div>
        <p class="surtitre">{t.programme.surtitre}</p>
        <h2>{t.programme.titreDebut}<em>{t.programme.titreAccent}</em></h2>
      </div>
      <p class="programme__intro">{t.programme.intro}</p>
    </div>

    <div class="onglets-annees" role="tablist" aria-label={t.programme.annees} data-onglets="annees">
      {
        ANNEES.map((a, i) => (
          <button
            type="button"
            role="tab"
            id={`onglet-annee-${a.numero}`}
            aria-controls={`annee-${a.numero}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
          >
            <span class="onglet__num">{a.numero}</span>
            <span class="onglet__texte">
              <b>{a.nom[langue]}</b>
              <small>{a.matieres.length > 0 ? t.programme.matieres(a.matieres.length) : t.programme.aVenir}</small>
            </span>
          </button>
        ))
      }
    </div>

    {
      ANNEES.map((a, i) => (
        <div class="annee" id={`annee-${a.numero}`} role="tabpanel" aria-labelledby={`onglet-annee-${a.numero}`} hidden={i !== 0}>
          <figure class="annee__couverture">
            <img src={a.photo} alt="" loading="lazy" width="1024" height="683" />
            <figcaption>
              <span class="annee__num">{a.numero}</span>
              <b>{a.nom[langue]}</b>
              <span>{a.matieres.length > 0 ? t.programme.matieres(a.matieres.length) : t.programme.aVenir}</span>
            </figcaption>
          </figure>
          <ol class="matieres">
            {a.matieres.map((m, k) => (
              <li class="matiere">
                <div class="matiere__haut">
                  <span>{String(k + 1).padStart(2, '0')}</span>
                  {langue !== 'ar' && <span class="ar" lang="ar">{m.arabe}</span>}
                </div>
                <h3>{m.titre[langue] ?? m.titre.fr}</h3>
                {m.detail && <p>{m.detail[langue] ?? m.detail.fr}</p>}
              </li>
            ))}
          </ol>
        </div>
      ))
    }

    <div class="aboutissement">
      <div class="aboutissement__bloc">
        <h3>{FIN_ETUDES.titre}</h3>
        <ul>
          {FIN_ETUDES.points.map((p) => <li>{p}</li>)}
        </ul>
        <p class="aboutissement__sous-titre">{FIN_ETUDES.exemplesTitre}</p>
        <ul class="aboutissement__exemples">
          {FIN_ETUDES.exemples.map((e) => <li>{e}</li>)}
        </ul>
      </div>
      <div class="aboutissement__bloc aboutissement__bloc--clair">
        <h3>{COMPETENCES.titre}</h3>
        <p>{COMPETENCES.intro}</p>
        <ul>
          {COMPETENCES.liste.map((c) => <li>{c}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<section class="bande-photo">
  <img src="/photos/mosquee.webp" alt="" loading="lazy" width="1024" height="768" />
  <div>
    <span class="ar" lang="ar">وَقُل رَّبِّ زِدْنِي عِلْمًا</span>
    {langue !== 'ar' && <span>{t.verset}</span>}
  </div>
</section>

<section class="cadre objectifs apparait">
  <div>
    <p class="surtitre">{t.objectifs.surtitre}</p>
    <h2>{t.objectifs.titre}</h2>
    <ul class="objectifs__liste">
      {t.objectifs.liste.map((o) => <li>{o}</li>)}
    </ul>
  </div>
  <figure class="objectifs__photo">
    <img src="/photos/lecture.webp" alt={t.objectifs.photoAlt} loading="lazy" width="1024" height="683" />
    <figcaption class="objectifs__badge">{t.objectifs.certificat}<small>{t.objectifs.certificatDetail}</small></figcaption>
    <span class="provisoire">{t.provisoire}</span>
  </figure>
</section>

<section class="cadre etapes apparait" id="etapes">
  <p class="surtitre">{t.etapes.surtitre}</p>
  <h2>{t.etapes.titre}</h2>
  <ol class="etapes__liste">
    {
      t.etapes.liste.map((e, i) => (
        <li class="etape">
          <span class="etape__rond" aria-hidden="true">{i + 1}</span>
          <h3>{e.titre}</h3>
          <p>{e.texte}</p>
        </li>
      ))
    }
  </ol>
</section>

<section class="cadre inscription" id="preinscription">
  <div class="inscription__boite">
    <div class="inscription__entete" data-bloc-formulaire>
      <p class="surtitre">{f.surtitre}</p>
      <h2>{f.titre}</h2>
      <p>{f.intro}</p>
      <div class="cursus-choisi">
        <span class="cursus-choisi__icone" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>
        </span>
        <span><b>{f.cursusTitre}</b><small>{f.cursusTexte}</small></span>
      </div>
    </div>

    <form
      class="formulaire"
      data-formulaire
      data-langue={langue}
      data-libelle-envoi={f.envoi}
      novalidate
    >
      <div class="piege" aria-hidden="true">
        <label>Site web <input type="text" name="site_web" tabindex="-1" autocomplete="off" /></label>
      </div>

      <div class="grille-2">
        <label class="champ">{f.prenom} *<input type="text" name="prenom" id="prenom" autocomplete="given-name" required maxlength="80" /></label>
        <label class="champ">{f.nom} *<input type="text" name="nom" id="nom" autocomplete="family-name" required maxlength="80" /></label>
        <label class="champ">{f.courriel} *<input type="email" name="courriel" id="courriel" autocomplete="email" required maxlength="160" dir="ltr" /></label>
        <label class="champ">{f.whatsapp} *<input type="tel" name="whatsapp" id="whatsapp" autocomplete="tel" required maxlength="25" placeholder="+33 6 12 34 56 78" dir="ltr" /></label>
        <label class="champ">{f.pays}
          <select name="pays" id="pays" autocomplete="country">
            {f.paysOptions.map((o) => <option value={o.valeur}>{o.libelle}</option>)}
          </select>
        </label>
        <label class="champ">{f.niveau}
          <select name="niveau" id="niveau">
            {f.niveauOptions.map((o) => <option value={o.valeur}>{o.libelle}</option>)}
          </select>
        </label>
      </div>

      <fieldset class="groupe">
        <legend>{f.creneaux}</legend>
        <div class="puces">
          {
            f.creneauxOptions.map((o) => (
              <label class="puce">
                <input type="checkbox" name="creneaux" value={o.valeur} />
                {o.libelle}
              </label>
            ))
          }
        </div>
      </fieldset>

      <label class="champ">{f.origine}
        <select name="origine" id="origine">
          {f.origineOptions.map((o) => <option value={o.valeur}>{o.libelle}</option>)}
        </select>
      </label>

      <div class="accords">
        <label class="accord"><input type="checkbox" name="majeur" id="majeur" required /><span>{f.majeur} *</span></label>
        <label class="accord"><input type="checkbox" name="consentement" id="consentement" required /><span>{f.consentement} *</span></label>
        <label class="accord accord--facultatif"><input type="checkbox" name="newsletter" id="newsletter" /><span>{f.newsletter}</span></label>
      </div>

      {cleTurnstile && <div class="cf-turnstile" data-sitekey={cleTurnstile} data-language={langue} />}

      <p class="message-erreur" data-message-erreur role="alert" hidden>{f.erreurEnvoi}</p>

      <button type="submit" class="btn btn--safran btn--grand formulaire__envoyer" data-envoyer>{f.envoyer}</button>

      <p class="formulaire__mentions">
        {f.mentions} <a href="/confidentialite/">{f.confidentialite}</a>
      </p>
    </form>

    <div class="merci" data-merci hidden tabindex="-1">
      <span class="merci__icone" aria-hidden="true">
        <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>
      </span>
      <h2>{f.merciTitre}</h2>
      <p>{f.merciTexte}</p>
    </div>
  </div>
</section>

<section class="cadre faq apparait" id="faq">
  <p class="surtitre">{t.faq.surtitre}</p>
  <h2>{t.faq.titre}</h2>
  <div class="faq__liste">
    {
      t.faq.liste.map((q) => (
        <details>
          <summary>
            {q.q}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
              <path d="M12 5v14M5 12h14" />
            </svg>
          </summary>
          <p>{q.r}</p>
        </details>
      ))
    }
  </div>
</section>

{cleTurnstile && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script>
  import { demarrer } from '../scripts/preinscription';
  demarrer();
</script>
