---
import '@fontsource/schibsted-grotesk/400.css';
import '@fontsource/schibsted-grotesk/500.css';
import '@fontsource/schibsted-grotesk/700.css';
import '@fontsource/schibsted-grotesk/800.css';
import '@fontsource/schibsted-grotesk/900.css';
import '@fontsource/readex-pro/400.css';
import '@fontsource/readex-pro/500.css';
import '@fontsource/readex-pro/700.css';
import '@fontsource/noto-naskh-arabic/500.css';
import '@fontsource/noto-naskh-arabic/700.css';
import '../styles/global.css';

import type { Langue } from '../data/cours';
import { ASSOCIATION, CHEMINS, DIRECTION, TEXTES } from '../i18n/textes';

interface Props {
  langue: Langue;
  titre?: string;
  description?: string;
}

// Le site n'est publié qu'en français depuis le 11/10/2026 : pas de sélecteur de langue ni de
// versions alternatives déclarées. La mise en page reste prête pour l'arabe (dir="rtl").
const { langue } = Astro.props;
const t = TEXTES[langue];
const titre = Astro.props.titre ?? t.meta.titre;
const description = Astro.props.description ?? t.meta.description;
const site = Astro.site ?? new URL('https://academie-shs.fr');
const canonique = new URL(Astro.url.pathname, site).href;
const image = new URL('/og-image.jpg', site).href;
const accueilLangue = CHEMINS[langue];
const LOCALE_OG: Record<Langue, string> = { fr: 'fr_FR', ar: 'ar_AR', en: 'en_GB' };
const nomPied = langue === 'en' ? ASSOCIATION.nomAnglais : langue === 'ar' ? ASSOCIATION.nomArabe : ASSOCIATION.nom;
---

<!doctype html>
<html lang={langue} dir={DIRECTION[langue]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#10372F" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Académie SHS" />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={LOCALE_OG[langue]} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="evitement" href="#contenu">{langue === 'ar' ? 'انتقل إلى المحتوى' : langue === 'en' ? 'Skip to content' : 'Aller au contenu'}</a>

    <header class="nav" data-nav>
      <div class="cadre nav__barre">
        <a href={accueilLangue} class="logo">
          <span class="logo__sceau" aria-hidden="true">ع</span>
          <span>{langue === 'ar' ? 'الأكاديمية' : 'Académie SHS'}</span>
        </a>
        <nav class="nav__liens" aria-label={t.nav.principale}>
          <a href={`${accueilLangue}#enligne`}>{t.nav.enligne}</a>
          <a href={`${accueilLangue}#programme`}>{t.nav.cursus}</a>
          <a href={`${accueilLangue}#faq`}>{t.nav.faq}</a>
        </nav>
        <a href={`${accueilLangue}#preinscription`} class="btn nav__cta">{t.nav.cta}</a>
      </div>
    </header>

    <main id="contenu">
      <slot />
    </main>

    <footer class="pied">
      <div class="cadre pied__colonnes">
        <div class="pied__colonne">
          <span class="logo"><span class="logo__sceau" aria-hidden="true">ع</span>Académie SHS</span>
          <span>{nomPied}</span>
        </div>
        <div class="pied__colonne">
          <b>{t.pied.association}</b>
          <span>{t.pied.statut}</span>
          <span>SIREN {ASSOCIATION.siren}</span>
          <span lang="fr">{ASSOCIATION.adresse}, {ASSOCIATION.ville}</span>
        </div>
        <div class="pied__colonne">
          <b>{t.pied.contact}</b>
          <a href={`mailto:${ASSOCIATION.courriel}`}>{ASSOCIATION.courriel}</a>
          <a href="/mentions-legales/">{t.pied.mentionsLegales}</a>
          <a href="/confidentialite/">{t.pied.confidentialite}</a>
        </div>
      </div>
      <div class="cadre pied__bas">© {new Date().getFullYear()} {ASSOCIATION.nom}</div>
    </footer>

    <script>
      import { demarrerPage } from '../scripts/interactions';
      demarrerPage();
    </script>
  </body>
</html>
